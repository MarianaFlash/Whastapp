# Copia este archivo a .env y edítalo.

# Contraseña para entrar al dashboard. Obligatoria. Usa una larga.
DASHBOARD_PASSWORD=cambia-esta-clave

# URL con la que abres el dashboard. Se incluye en los mensajes de WhatsApp.
# Sin dominio: http://IP_DEL_SERVIDOR:3000   Con dominio: https://pendientes.tudominio.com
PUBLIC_URL=http://IP_DEL_SERVIDOR:3000

# Zona horaria para el horario silencioso y los resúmenes.
TZ=America/Bogota

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# --- Solo si usas HTTPS con Caddy (docker compose --profile https up -d) ---
# DOMAIN=pendientes.tudominio.com
# BIND_ADDRESS=127.0.0.1
